<Window x:Class="XycloToothSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XycloTooth File Bridge Setup"
        Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">
    
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="XycloTooth File Bridge" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
            <TextBlock Text="Setup Wizard - Zero-Touch Bluetooth Text File Pipeline" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Body -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Installation Directory:" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtInstallDir" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" Padding="8,6" VerticalContentAlignment="Center"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse..." Background="#334155" Foreground="White" Padding="12,6" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
            </Grid>

            <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut" Foreground="#F8FAFC" IsChecked="True" Margin="0,0,0,10"/>
            <CheckBox x:Name="ChkStartMenuShortcut" Content="Create Start Menu Shortcut" Foreground="#F8FAFC" IsChecked="True" Margin="0,0,0,10"/>
            <CheckBox x:Name="ChkCreateDirs" Content="Create default Input &amp; Output directories" Foreground="#F8FAFC" IsChecked="True" Margin="0,0,0,10"/>
            <CheckBox x:Name="ChkLaunchApp" Content="Launch XycloTooth File Bridge after installation" Foreground="#F8FAFC" IsChecked="True" Margin="0,0,0,16"/>

            <!-- Progress & Status -->
            <TextBlock x:Name="TxtStatus" Text="Ready to install." FontSize="12" Foreground="#38BDF8" Margin="0,0,0,6"/>
            <ProgressBar x:Name="PbInstall" Height="8" Background="#1E293B" Foreground="#38BDF8" Maximum="100" Value="0"/>
        </StackPanel>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel" Content="Cancel" Background="#334155" Foreground="White" Padding="18,8" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnInstall" Content="Install" Background="#38BDF8" Foreground="#0F172A" FontWeight="Bold" Padding="24,8" Click="BtnInstall_Click"/>
        </StackPanel>
    </Grid>
</Window>
