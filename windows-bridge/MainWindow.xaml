<Window x:Class="XycloToothBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XycloTooth - Automated Bluetooth Bridge"
        Height="720" Width="960"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Status Cards -->
            <RowDefinition Height="*"/>    <!-- Main Content Tabs / Panels -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="XYCLOTOOTH" FontWeight="Bold" FontSize="20" Foreground="#38BDF8" Margin="0,0,8,0"/>
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="AUTOMATED TEXT FILE BRIDGE" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Zero-touch Bluetooth RFCOMM ↔ Android ↔ Server Pipeline" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSendFile" Content="📤 Send .txt File" Margin="0,0,10,0" Click="BtnSendFile_Click"/>
                    <Button x:Name="BtnToggleService" Content="▶ Start Service" Background="#10B981" Click="BtnToggleService_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bluetooth Adapter Status -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="BLUETOOTH ADAPTER" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="IndicatorAdapter" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtAdapterStatus" Text="Offline" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Phone Connection Status -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="ANDROID STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="IndicatorConnection" Width="10" Height="10" Fill="#F59E0B" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtConnectionStatus" Text="Listening..." FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Last Sent File -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="LAST SENT FILE" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtLastSent" Text="None" FontWeight="Bold" FontSize="13" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Last Received File -->
            <Border Grid.Column="3" Background="#1E293B" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="LAST RECEIVED FILE" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtLastReceived" Text="None" FontWeight="Bold" FontSize="13" Margin="0,6,0,0" Foreground="#34D399" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area: Left = Configuration, Right = Live Logs -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Settings & Configuration -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Configuration" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                        <!-- Paired Device Selection -->
                        <TextBlock Text="Target Android Device (Paired)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbDevices" Grid.Column="0"/>
                            <Button x:Name="BtnRefreshDevices" Grid.Column="1" Content="🔄" Width="36" Margin="6,0,0,0" Padding="0" Click="BtnRefreshDevices_Click" ToolTip="Refresh Paired Devices"/>
                        </Grid>

                        <!-- Input Directory -->
                        <TextBlock Text="Input Directory (PC → Android)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtInputDir" Grid.Column="0" IsReadOnly="True"/>
                            <Button x:Name="BtnBrowseInput" Grid.Column="1" Content="📁" Width="36" Margin="6,0,0,0" Padding="0" Click="BtnBrowseInput_Click" ToolTip="Browse Folder"/>
                        </Grid>

                        <!-- Output Directory -->
                        <TextBlock Text="Output Directory (Android → PC)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOutputDir" Grid.Column="0" IsReadOnly="True"/>
                            <Button x:Name="BtnBrowseOutput" Grid.Column="1" Content="📁" Width="36" Margin="6,0,0,0" Padding="0" Click="BtnBrowseOutput_Click" ToolTip="Browse Folder"/>
                        </Grid>

                        <Separator Background="#334155" Margin="0,4,0,12"/>

                        <!-- Checkboxes -->
                        <CheckBox x:Name="ChkAutoTransfer" Content="Automatic Transfer on File Drop" Foreground="#F8FAFC" Margin="0,0,0,10" IsChecked="True"/>
                        <CheckBox x:Name="ChkAutoStart" Content="Launch with Windows Startup" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to System Tray on Close" Foreground="#F8FAFC" Margin="0,0,0,14" IsChecked="True"/>

                        <!-- Action Buttons -->
                        <Button x:Name="BtnSaveSettings" Content="Save Configuration" Background="#475569" Click="BtnSaveSettings_Click" HorizontalAlignment="Stretch"/>

                        <!-- Transfer Progress Display -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Transfer Progress" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtCurrentTransfer" Text="Idle" FontSize="12" Margin="0,4,0,6" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="PbTransfer" Height="6" Background="#1E293B" Foreground="#38BDF8" Value="0" Maximum="100"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Real-time Structured Logs -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Live Activity Log" FontSize="16" FontWeight="Bold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnClearLogs" Content="Clear" Background="#334155" Padding="10,4" Margin="0,0,6,0" Click="BtnClearLogs_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="TxtLogs" Grid.Row="1" Background="#0F172A" Foreground="#CBD5E1" 
                             BorderThickness="1" BorderBrush="#334155" 
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" 
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
