<Window x:Class="XycloToothBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XycloTooth Bridge"
        Height="780" Width="1060"
        MinHeight="640" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Inter, Arial">
    
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <!-- Modern Tab Navigation Radio Button Style -->
        <Style x:Key="TabNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Status Cards -->
            <RowDefinition Height="*"/>    <!-- Main Content Area -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,12" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="XYCLOTOOTH" FontWeight="Bold" FontSize="20" Foreground="#38BDF8" Margin="0,0,8,0"/>
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="BLUETOOTH BRIDGE" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="RFCOMM Bluetooth Bridge | Output: C:\labfinal" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenLabFinalTop" Content="📁 Open C:\labfinal" Background="#334155" Margin="0,0,10,0" Click="BtnOpenLabFinal_Click" ToolTip="Open the output responses folder"/>
                    <Button x:Name="BtnToggleService" Content="▶ Start Service" Background="#10B981" Click="BtnToggleService_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Bluetooth Adapter Status -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="BLUETOOTH ADAPTER" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="IndicatorAdapter" Width="10" Height="10" Fill="#EF4444" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtAdapterStatus" Text="Offline" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Phone Connection Status -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="DEVICE STATUS" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="IndicatorConnection" Width="10" Height="10" Fill="#F59E0B" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtConnectionStatus" Text="Listening..." FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Last Sent -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="12" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="LAST SENT" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtLastSent" Text="None" FontWeight="Bold" FontSize="13" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Last Received -->
            <Border Grid.Column="3" Background="#1E293B" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="LAST RECEIVED (C:\labfinal)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtLastReceived" Text="None" FontWeight="Bold" FontSize="13" Margin="0,6,0,0" Foreground="#34D399" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Area: Left = Configuration, Right = Chat & Logs -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Settings & Configuration -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Device &amp; Setup" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                        <!-- Paired Device Selection -->
                        <TextBlock Text="Target Device (Paired)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbDevices" Grid.Column="0" SelectionChanged="CmbDevices_SelectionChanged"/>
                            <Button x:Name="BtnRefreshDevices" Grid.Column="1" Content="🔄" Width="36" Margin="6,0,0,0" Padding="0" Click="BtnRefreshDevices_Click" ToolTip="Refresh Paired Devices"/>
                        </Grid>

                        <!-- Output Directory (Always C:\labfinal) -->
                        <TextBlock Text="Output Directory" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtOutputDir" Grid.Column="0" Text="C:\labfinal" IsReadOnly="True" ToolTip="Responses are saved here as text files"/>
                            <Button x:Name="BtnBrowseOutput" Grid.Column="1" Content="📁" Width="36" Margin="6,0,0,0" Padding="0" Click="BtnOpenLabFinal_Click" ToolTip="Open Output Folder"/>
                        </Grid>

                        <!-- Input Directory -->
                        <TextBlock Text="Staging Directory" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtInputDir" Grid.Column="0" IsReadOnly="True"/>
                            <Button x:Name="BtnBrowseInput" Grid.Column="1" Content="📁" Width="36" Margin="6,0,0,0" Padding="0" Click="BtnBrowseInput_Click" ToolTip="Browse Folder"/>
                        </Grid>

                        <Separator Background="#334155" Margin="0,4,0,10"/>

                        <!-- Checkboxes -->
                        <CheckBox x:Name="ChkAutoTransfer" Content="Automatic Transfer on File Drop" Foreground="#F8FAFC" Margin="0,0,0,8" IsChecked="True"/>
                        <CheckBox x:Name="ChkAutoStart" Content="Launch with Windows Startup" Foreground="#F8FAFC" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to System Tray on Close" Foreground="#F8FAFC" Margin="0,0,0,12" IsChecked="True"/>

                        <!-- Action Buttons -->
                        <Button x:Name="BtnSaveSettings" Content="Save Configuration" Background="#475569" Click="BtnSaveSettings_Click" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                        <Button x:Name="BtnSendFileManual" Content="📤 Send .txt File from Disk" Background="#334155" Click="BtnSendFile_Click" HorizontalAlignment="Stretch"/>

                        <!-- Transfer Progress Display -->
                        <Border Background="#0F172A" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Transfer Progress" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                                <TextBlock x:Name="TxtCurrentTransfer" Text="Idle" FontSize="12" Margin="0,4,0,6" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="PbTransfer" Height="6" Background="#1E293B" Foreground="#38BDF8" Value="0" Maximum="100"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Tabbed Chat & Logs Area -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Tab switcher & header controls -->
                        <RowDefinition Height="*"/>    <!-- Content: Chat or Logs -->
                    </Grid.RowDefinitions>

                    <!-- Tab Switcher Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RadioTabChat" Content="💬 Chat" Style="{StaticResource TabNavButtonStyle}" IsChecked="True" Checked="RadioTab_Checked" Margin="0,0,6,0"/>
                            <RadioButton x:Name="RadioTabLogs" Content="📋 Activity Log" Style="{StaticResource TabNavButtonStyle}" Checked="RadioTab_Checked"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnClearChat" Content="🗑 Clear Chat" Background="#334155" Padding="10,4" Margin="0,0,6,0" Click="BtnClearChat_Click"/>
                            <Button x:Name="BtnClearLogs" Content="Clear Logs" Background="#334155" Padding="10,4" Click="BtnClearLogs_Click" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 1: Chat Window Panel -->
                    <Grid x:Name="PanelChat" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>    <!-- Chat messages view -->
                            <RowDefinition Height="Auto"/> <!-- Input box & Send button -->
                        </Grid.RowDefinitions>

                        <!-- Messages ScrollViewer -->
                        <Border Grid.Row="0" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,10">
                            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12">
                                <StackPanel x:Name="ChatMessagesList">
                                    <!-- Empty state placeholder card -->
                                    <Border x:Name="ChatEmptyState" Background="#1E293B" CornerRadius="8" Padding="20" Margin="10,20,10,10" HorizontalAlignment="Center" MaxWidth="500">
                                        <TextBlock Text="Ready. Type a message below and press Enter to send." 
                                                   TextWrapping="Wrap" Foreground="#94A3B8" FontSize="13" TextAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Message Input Area -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0F172A" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="4">
                                <TextBox x:Name="TxtChatPrompt" 
                                         Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"
                                         FontSize="13" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" MinHeight="58" MaxHeight="120"
                                         Padding="8,6" VerticalContentAlignment="Top"
                                         KeyDown="TxtChatPrompt_KeyDown"
                                         ToolTip="Enter message here. Press Enter to send, Shift+Enter for new line."/>
                            </Border>

                            <Button x:Name="BtnSendPrompt" Grid.Column="1" Content="Send" 
                                    Margin="8,0,0,0" Padding="22,0" Height="68"
                                    Background="#2563EB" FontWeight="Bold" FontSize="13"
                                    Click="BtnSendPrompt_Click" ToolTip="Send message over Bluetooth"/>
                        </Grid>
                    </Grid>

                    <!-- TAB 2: Live Activity Logs Panel -->
                    <Grid x:Name="PanelLogs" Grid.Row="1" Visibility="Collapsed">
                        <TextBox x:Name="TxtLogs" Background="#0F172A" Foreground="#CBD5E1" 
                                 BorderThickness="1" BorderBrush="#334155" 
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" 
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
